{
  "apiVersion": "yingce.plugin/v2",
  "id": "supdance-music-generation",
  "name": "Supdance音乐音频生成",
  "version": "1.2.1",
  "publishedAt": "2026-10-29",
  "updatedAt": "2026-10-31",
  "minHostVersion": "1.7.1",
  "author": "SupDance Team",
  "description": "音乐工作台使用后台配置的平台音乐模型、统一音频生成任务与实时报价，提供简单和歌词创作、目标时长、原始 MP3 播放下载及共享任务历史。模型与版本由渠道配置决定。",
  "surfaces": [
    "fullscreen",
    "settings",
    "hybrid"
  ],
  "permissions": [
    "canvas.read",
    "canvas.write",
    "asset.read",
    "asset.upload",
    "generation.run",
    "ai.text",
    "media.read"
  ],
  "trusted": true,
  "runtime": {
    "backend": "declarative",
    "web": "declarative"
  },
  "contributes": {
    "usageObservers": [
      "supdance-music-generation"
    ],
    "commands": [
      {
        "id": "supdance-music-generation.open-studio",
        "label": "打开 AI 音乐创作岛"
      },
      {
        "id": "supdance-music-generation.admin-settings",
        "label": "管理音乐生成插件设置"
      }
    ],
    "aiCapabilities": [
      "music-generation",
      "audio"
    ]
  }
}
