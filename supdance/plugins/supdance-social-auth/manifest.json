{
  "apiVersion": "yingce.plugin/v2",
  "id": "supdance-social-auth",
  "name": "Supdance社交登录配置",
  "version": "1.4.0",
  "publishedAt": "2026-10-27",
  "updatedAt": "2026-11-03",
  "minHostVersion": "1.7.1",
  "author": "SupDance",
  "description": "SupDance 统一第三方社交登录插件 v1.4.0：支持全功能设置与个人中心居中磨砂浮窗融合；支持 IP 智能分区、运营大盘与账号换绑解绑；入站票据持久化至共享 Redis，重启与多副本不丢失。",
  "surfaces": ["auth", "settings", "onboarding-modal", "user-account-bindings"],
  "permissions": ["canvas.read"],
  "trusted": true,
  "runtime": {
    "backend": "declarative",
    "web": "declarative"
  },
  "contributes": {
    "usageObservers": ["supdance-social-auth"],
    "commands": [
      {
        "id": "supdance-social-auth.admin-config",
        "label": "管理社交登录渠道配置"
      }
    ]
  }
}
