{
  "apiVersion": "yingce.plugin/v2",
  "id": "supdance-social-auth",
  "name": "Supdance社交登录配置",
  "version": "1.3.0",
  "publishedAt": "2026-10-27",
  "updatedAt": "2026-11-02",
  "minHostVersion": "1.7.1",
  "author": "SupDance",
  "description": "SupDance 统一第三方社交登录插件 v1.3.0：支持 IP 智能分区展示、简化凭据配置（无 Mock 沙箱、Fail-closed 严格鉴权）、四列式即时开关设置及运营控制与大盘。",
  "surfaces": ["auth", "settings", "onboarding-modal", "user-account-bindings"],
  "permissions": ["canvas.read"],
  "trusted": true,
  "runtime": {
    "backend": "declarative",
    "web": "declarative"
  },
  "contributes": {
    "usageObservers": ["supdance-social-auth"],
    "commands": [
      {
        "id": "supdance-social-auth.admin-config",
        "label": "管理社交登录渠道配置"
      }
    ]
  }
}
