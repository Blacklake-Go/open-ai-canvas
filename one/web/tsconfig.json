{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@supdance/studio": ["./src/packages/studio/src/index.js"],
      "studio": ["./src/packages/studio/src/index.js"],
      "studio/ui": ["./src/packages/studio/src/ui/index.js"],
      "studio/ui/field": ["./src/packages/studio/src/ui/Field.jsx"],
      "studio/ui/navigation": ["./src/packages/studio/src/ui/Navigation.jsx"],
      "studio/ui/overlay": ["./src/packages/studio/src/ui/Overlay.jsx"],
      "studio/ui/tokens": ["./src/packages/studio/src/ui/tokens.js"],
      "studio/ui/button": ["./src/packages/studio/src/ui/Button.jsx"],
      "studio/ui/feedback": ["./src/packages/studio/src/ui/Feedback.jsx"],
      "studio/ui/surface": ["./src/packages/studio/src/ui/Surface.jsx"],
      "studio/*": ["./src/packages/studio/src/*", "./src/packages/studio/src/components/*"],
      "ai-agent": ["./src/packages/Open-Poe-AI/packages/agents/src/index.js"],
      "workflow-builder": ["./src/packages/Vibe-Workflow/packages/workflow-builder/src/index.js"],
      "design-agent": ["./src/packages/Open-AI-Design-Agent/packages/design-agent/src/index.js"],
      "next/link": ["./src/compat/next-link.tsx"],
      "next/navigation": ["./src/compat/next-navigation.tsx"],
      "next/image": ["./src/compat/next-image.tsx"],
      "next/script": ["./src/compat/next-script.tsx"],
      "next/dynamic": ["./src/compat/next-dynamic.tsx"],
      "next-themes": ["./src/compat/next-themes.tsx"],
      "next-intl": ["./src/compat/next-intl.tsx"],
      "next-intl/server": ["./src/compat/next-intl-server.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
