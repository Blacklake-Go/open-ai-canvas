FROM golang:1.26-alpine AS builder
WORKDIR /app/backend
COPY one/backend/go.mod one/backend/go.sum* ./
RUN go mod download
COPY one/backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/one-backend ./cmd/server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S one \
 && adduser -S -G one one \
 && mkdir -p /data/storage \
 && chown -R one:one /data/storage
WORKDIR /app
COPY --from=builder /out/one-backend /usr/local/bin/one-backend
USER one
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/one-backend"]
