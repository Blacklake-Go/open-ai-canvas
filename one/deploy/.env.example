# ONE Production / Staging Environment Example
NODE_ENV=production
ONE_HTTP_PORT=3000
PUBLIC_APP_URL=https://www.supdance.com
ONE_COOKIE_DOMAIN=
ADDITIONAL_ALLOWED_ORIGINS=
ONE_CSRF_ORIGIN_REQUIRED=true

POSTGRES_DB=supdance
POSTGRES_USER=supdance
POSTGRES_PASSWORD=replace-with-strong-postgres-password
PG_MAX_CONNECTIONS=20
PG_MIN_CONNECTIONS=2
REDIS_PASSWORD=replace-with-strong-redis-password

# Core application secrets (AUTH_SECRET acts as fallback for derived secrets)
AUTH_SECRET=replace-with-32-plus-char-random-auth-secret
AUTH_VERIFICATION_CODE_SECRET=
OAUTH_STATE_SECRET=
BILLING_SESSION_SECRET=
PROVIDER_SECRETS_ENCRYPTION_KEY=
STORAGE_SECRETS_ENCRYPTION_KEY=
ADMIN_SECRET_KEY=
ONE_STORAGE_LOCAL_ROOT=/data/storage
ALLOWED_PRIVATE_UPSTREAM_HOSTS=
INVITE_CODE_REQUIRED=true

# Must be >= 32 characters; shared exclusively between backend and agent
ONE_AGENT_TOKEN=replace-with-32-plus-char-random-bearer-secret
ONE_AGENT_MAX_CONCURRENT=4
ONE_AGENT_LLM_PROVIDER=openai
ONE_AGENT_LLM_MODEL=gpt-4o-mini
ONE_AGENT_LLM_BASE_URL=
ONE_AGENT_LLM_API_KEY=
ONE_WORKER_DISABLED=false

# Local copy of the 99 baseline PostgreSQL migrations (synced in ./migrations)
ONE_MIGRATIONS_HOST_DIR=./migrations

# OAuth & Google One Tap
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=

# Payment gateways (leave blank when unused)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY=
ALIPAY_NOTIFY_URL=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PUBLIC_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=live

# Upstream AI & generation callbacks (server-managed credentials only; BYOK closed)
UPSTREAM_AI_BASE=https://api.muapi.ai
MUAPI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
VOLCENGINE_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
RUNNINGHUB_API_KEY=
GENERATION_CALLBACK_SECRET=
GENERATION_CALLBACK_HMAC_SECRET=

# Optional SMS gateway overrides (alternatively configured in admin UI / DB)
SMS_CHINA_PRIMARY=tencent_sms
SMS_CHINA_FALLBACK=aliyun_sms
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Optional overrides for /api/seo/indexnow-key, X crawler, and /api/v1/upload-binary allowlist
INDEXNOW_KEY=
X_BEARER_TOKEN=
UPLOAD_PROXY_ALLOWED_HOSTS=
