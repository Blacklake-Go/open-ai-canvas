# Build stage
FROM oven/bun:1.3.9-alpine AS builder
WORKDIR /app/web
COPY one/web/package.json one/web/bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY one/web/ ./
RUN bun run build

# Production stage
FROM nginx:1.27-alpine
COPY one/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
